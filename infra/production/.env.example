# Tributary production env. Copy to infra/production/.env, chmod 600, fill in, never commit.
# compose.yml reads the ${...} values; the tributary container gets the whole file as env_file.

# ── Hostnames ─────────────────────────────────────────────────────────────────
# The console + API origin. Caddy (Free School's) must have a site block for it.
TRIBUTARY_HOST=boulderevents.directory
# The name of Free School's compose network on this box (`docker network ls`).
EDGE_NETWORK=production_default

# ── Region and brand ──────────────────────────────────────────────────────────
REGION_SLUG=boulder
REGION_NAME=Boulder
REGION_TZ=America/Denver
REGION_COUNTRY=US
BRAND_NAME=Boulder Events Directory
ADAPTER_NAME=Tributary

# ── The Directory's own PDS (the `directory-pds` service in compose.yml) ──────
PDS_HOST=pds.boulderevents.directory
# Handles are minted as <label>.<this>. DNS needs `*.<this>` pointing at the box.
PDS_HANDLE_DOMAIN=boulderevents.directory
# openssl rand -hex 16 / -hex 32 / the ec key one-liner below
PDS_ADMIN_PASSWORD=
PDS_JWT_SECRET=
# openssl ecparam -name secp256k1 -genkey -noout -outform DER | tail -c +8 | head -c 32 | xxd -p -c 32
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
# `https://bsky.network` announces this PDS to the relay so published events are visible
# network-wide. Empty keeps it off the firehose.
PDS_CRAWLERS=https://bsky.network
# Must be an address on a domain verified with the SMTP provider.
PDS_EMAIL_FROM=hello@freeskool.xyz

# ── Postgres (openssl rand -hex 24) ───────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Secrets ───────────────────────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=
# 32+ chars, shared with the Gate: openssl rand -hex 32
GATE_SERVICE_SECRET=
# v1:<base64 of 32 random bytes>  (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
CUSTODY_KEYS=v1:
CUSTODY_KEY_VERSION=v1
# For the Cloudflare Email Worker → /api/inbound/email (empty = channel off)
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=in.freeskool.directory
# Telegram bot (P7): token from @BotFather; the webhook secret is any 32+ char string
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# For GET /api/public/stats and the steward queue
STEWARD_KEY=
# Optional: a fixed ES256 private JWK for the OAuth client (generated and stored in Postgres when empty)
OAUTH_PRIVATE_JWK=

# ── Enrichment and extraction (all optional) ──────────────────────────────────
# Google Calendar API key: enables the incremental Calendar API path for public calendars
GOOGLE_API_KEY=
# Self-hosted Photon (geocoding), see infra/photon. Empty = the built-in gazetteer only.
PHOTON_URL=
# Meilisearch, see infra/meili. Empty = a Postgres substring match.
MEILI_URL=
MEILI_MASTER_KEY=
# Anthropic API key: enables flyers, free text, unstructured pages and email extraction.
EXTRACT_MODEL_API_KEY=
EXTRACT_MODEL=claude-haiku-4-5

# ── Email (REQUIRED in production) ────────────────────────────────────────────
# Resend over SMTP, port 2465 (Hetzner blocks 25/465). Same key as Free School works.
SMTP_URL=smtps://resend:re_xxx@smtp.resend.com:2465
MAIL_FROM=Boulder Directory <hello@freeskool.xyz>
