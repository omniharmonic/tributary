{
  "name": "@tributary/tributary",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "description": "Tributary API, workers and connector runtime.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "smoke": "tsx scripts/smoke.ts",
    "checks": "tsx scripts/checks.ts",
    "reindex": "tsx scripts/reindex.ts",
    "seed-sources": "tsx scripts/seed-sources.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@atproto/api": "^0.20.44",
    "@atproto/identity": "0.5.13",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/oauth-client-node": "^0.5.7",
    "@hono/node-server": "^2.1.1",
    "@tributary/connectors": "workspace:*",
    "@tributary/detect": "workspace:*",
    "@tributary/event-model": "workspace:*",
    "@tributary/identity": "workspace:*",
    "@tributary/policy": "workspace:*",
    "@tributary/publisher": "workspace:*",
    "@tributary/spaces-shim": "workspace:*",
    "@tributary/ssrf-fetch": "workspace:*",
    "@tributary/visibility": "workspace:*",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "luxon": "^3.7.2",
    "meilisearch": "^0.62.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.16.3",
    "pg-boss": "^12.31.0",
    "rrule": "^2.8.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
